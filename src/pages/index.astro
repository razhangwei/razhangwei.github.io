---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const homePath = getRelativeLocaleUrl(locale, "");

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: config.site.author,
    url: config.site.url,
    jobTitle: "Staff ML engineer",
    sameAs: [
      "https://github.com/razhangwei",
      "https://www.linkedin.com/in/weizhangfb/",
      "https://scholar.google.com/citations?user=ToHDHHsAAAAJ",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: config.site.title,
    url: config.site.url,
    description: config.site.description,
  },
];
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="hero"
      class="border-border border-b pt-14 pb-12 sm:pt-20 sm:pb-16"
    >
      <p class="text-accent text-sm font-semibold tracking-[0.16em] uppercase">
        Field notes on ML systems
      </p>
      <div class="mt-5 flex items-start justify-between gap-6">
        <h1
          class="max-w-2xl text-4xl leading-[1.08] font-semibold tracking-tight sm:text-6xl"
        >
          Building better intuitions for systems that learn from people.
        </h1>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={getRelativeLocaleUrl(locale, "rss.xml")}
          class="text-accent hover:text-foreground mt-2 shrink-0 p-2 transition-colors"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={20} height={20} class="stroke-current stroke-2" />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="mt-7 max-w-xl text-lg leading-relaxed sm:text-xl">
        I’m Wei Zhang, a Staff ML engineer at Meta.
      </p>
      <p class="text-muted-foreground mt-4 max-w-xl leading-relaxed">
        This is a home for future writing and selected public work. Read more
        <LinkButton
          class="text-foreground hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          about me
        </LinkButton>.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-7 flex max-sm:flex-col sm:items-center">
            <div class="text-muted-foreground me-3 mb-1 text-sm whitespace-nowrap sm:mb-0">
              Find me elsewhere
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="selected-work" class="py-12 sm:py-16">
      <p class="text-accent text-sm font-semibold tracking-[0.14em] uppercase">
        Elsewhere
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight">
        Selected public work
      </h2>
      <div class="mt-7 grid gap-4 sm:grid-cols-3">
        <a
          href="https://scholar.google.com/citations?user=ToHDHHsAAAAJ"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-border hover:border-accent block border p-5 transition-colors"
        >
          <p class="text-muted-foreground text-sm">Research</p>
          <h3
            class="group-hover:text-accent mt-2 text-lg font-semibold transition-colors"
          >
            Publications
          </h3>
        </a>
        <a
          href="https://github.com/razhangwei"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-border hover:border-accent block border p-5 transition-colors"
        >
          <p class="text-muted-foreground text-sm">Code</p>
          <h3
            class="group-hover:text-accent mt-2 text-lg font-semibold transition-colors"
          >
            GitHub projects
          </h3>
        </a>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "work")}
          class="group border-border hover:border-accent block border p-5 transition-colors"
        >
          <p class="text-muted-foreground text-sm">Overview</p>
          <h3
            class="group-hover:text-accent mt-2 text-lg font-semibold transition-colors"
          >
            Work &amp; background
          </h3>
        </LinkButton>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
