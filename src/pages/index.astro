---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const essays = sortedPosts.filter(
  ({ data }) => !data.featured && data.kind === "essay"
);
const researchNotes = sortedPosts.filter(({ data }) => data.kind === "note");
const homePath = getRelativeLocaleUrl(locale, "");

const topics = [
  {
    title: "Recommendation systems",
    description:
      "Retrieval, ranking, feedback loops, and the product systems around them.",
    href: getRelativeLocaleUrl(locale, "tags/recommendation-systems"),
  },
  {
    title: "ML systems",
    description:
      "How models, data, evaluation, and serving shape one another in practice.",
    href: getRelativeLocaleUrl(locale, "tags/ml-systems"),
  },
  {
    title: "Research notes",
    description:
      "Questions, paper trails, and ideas worth keeping in public view.",
    href: getRelativeLocaleUrl(locale, "notes"),
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: config.site.author,
    url: config.site.url,
    jobTitle: "Staff ML engineer",
    sameAs: [
      "https://github.com/razhangwei",
      "https://www.linkedin.com/in/weizhangfb/",
      "https://scholar.google.com/citations?user=ToHDHHsAAAAJ",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: config.site.title,
    url: config.site.url,
    description: config.site.description,
  },
];
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="hero"
      class="border-border border-b pt-14 pb-12 sm:pt-20 sm:pb-16"
    >
      <p class="text-accent text-sm font-semibold tracking-[0.16em] uppercase">
        Field notes on ML systems
      </p>
      <div class="mt-5 flex items-start justify-between gap-6">
        <h1
          class="max-w-2xl text-4xl leading-[1.08] font-semibold tracking-tight sm:text-6xl"
        >
          Building better intuitions for systems that learn from people.
        </h1>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={getRelativeLocaleUrl(locale, "rss.xml")}
          class="text-accent hover:text-foreground mt-2 shrink-0 p-2 transition-colors"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={20} height={20} class="stroke-current stroke-2" />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="mt-7 max-w-xl text-lg leading-relaxed sm:text-xl">
        I’m Wei Zhang, a Staff ML engineer at Meta. I write about recommendation
        systems, multimodal models, and the practical work of turning a learning
        system into a useful product.
      </p>
      <p class="text-muted-foreground mt-4 max-w-xl leading-relaxed">
        This is a public notebook for durable ideas: essays when an argument has
        earned structure, and notes while the questions are still open. Read
        more
        <LinkButton
          class="text-foreground hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          about me
        </LinkButton>.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-7 flex max-sm:flex-col sm:items-center">
            <div class="text-muted-foreground me-3 mb-1 text-sm whitespace-nowrap sm:mb-0">
              Find me elsewhere
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "py-12 sm:py-16",
            {
              "border-border border-b":
                essays.length > 0 || researchNotes.length > 0,
            },
          ]}
        >
          <div class="mb-7 flex items-baseline justify-between gap-4">
            <div>
              <p class="text-accent text-sm font-semibold tracking-[0.14em] uppercase">
                Start here
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-tight">
                Featured writing
              </h2>
            </div>
          </div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      essays.length > 0 && (
        <section
          id="latest-writing"
          class="border-border border-b py-12 sm:py-16"
        >
          <div class="mb-7 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-sm font-semibold tracking-[0.14em] uppercase">
                Essays
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-tight">
                Latest writing
              </h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "posts")}
              class="text-sm font-medium whitespace-nowrap"
            >
              All writing{" "}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            {essays.slice(0, Math.min(3, postsConfig.perIndex)).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section id="topics" class="border-border border-b py-12 sm:py-16">
      <p class="text-accent text-sm font-semibold tracking-[0.14em] uppercase">
        Explore
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight">
        Topics I return to
      </h2>
      <div class="mt-7 grid gap-x-8 gap-y-6 sm:grid-cols-3">
        {
          topics.map(topic => (
            <a
              href={topic.href}
              class="group border-border block border-t pt-4"
            >
              <h3 class="group-hover:text-accent text-lg font-semibold transition-colors">
                {topic.title}
              </h3>
              <p class="text-muted-foreground mt-2 leading-relaxed">
                {topic.description}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    {
      researchNotes.length > 0 && (
        <section
          id="research-notes"
          class="border-border border-b py-12 sm:py-16"
        >
          <div class="mb-7 flex items-end justify-between gap-4">
            <div>
              <p class="text-accent text-sm font-semibold tracking-[0.14em] uppercase">
                Notebook
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-tight">
                Research notes
              </h2>
            </div>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "notes")}
              class="text-sm font-medium whitespace-nowrap"
            >
              All notes <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul>
            {researchNotes.slice(0, 3).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section id="selected-work" class="py-12 sm:py-16">
      <p class="text-accent text-sm font-semibold tracking-[0.14em] uppercase">
        Elsewhere
      </p>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight">
        Selected public work
      </h2>
      <div class="mt-7 grid gap-4 sm:grid-cols-3">
        <a
          href="https://scholar.google.com/citations?user=ToHDHHsAAAAJ"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-border hover:border-accent block border p-5 transition-colors"
        >
          <p class="text-muted-foreground text-sm">Research</p>
          <h3
            class="group-hover:text-accent mt-2 text-lg font-semibold transition-colors"
          >
            Publications
          </h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Academic work and citations.
          </p>
        </a>
        <a
          href="https://github.com/razhangwei"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-border hover:border-accent block border p-5 transition-colors"
        >
          <p class="text-muted-foreground text-sm">Code</p>
          <h3
            class="group-hover:text-accent mt-2 text-lg font-semibold transition-colors"
          >
            GitHub projects
          </h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Experiments, tools, and open-source work.
          </p>
        </a>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "work")}
          class="group border-border hover:border-accent block border p-5 transition-colors"
        >
          <p class="text-muted-foreground text-sm">Overview</p>
          <h3
            class="group-hover:text-accent mt-2 text-lg font-semibold transition-colors"
          >
            Work &amp; background
          </h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            A concise guide to my public professional profile.
          </p>
        </LinkButton>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
