---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`Now | ${config.site.title}`}
  description="What Wei Zhang is paying attention to now."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Now"
    pageDesc="A lightweight snapshot, updated whenever it becomes stale."
    class="app-prose now-page"
  >
    <p class="text-muted-foreground">Updates will appear here when ready.</p>
  </Main>
  <Footer />
</Layout>
